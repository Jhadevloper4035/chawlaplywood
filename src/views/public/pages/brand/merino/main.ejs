  <section class="brand-about" aria-labelledby="merinoAboutTitle">
    <div class="container-lg">
      <div class="brand-about__content">
        <h2 id="merinoAboutTitle">Merino Surface Solutions</h2>
        <span class="brand-about__divider" aria-hidden="true"></span>
        <p>
          Merino offers surface solutions for homes, offices, commercial, and public spaces. Its portfolio combines durable laminates, coated panels, solid surfaces, and Fabwood solutions for furniture, kitchens, wardrobes, wall applications, and other interior projects. With a wide selection of designs, textures, finishes, and performance options, Merino helps homeowners, architects, interior designers, and builders create surfaces that balance everyday durability with a refined look.
        </p>
        <div class="mt-30">
          <a class="btn-primary" href="#contact-expert">
            <span class="btn-animated-text" data-text="Connect to an Expert">Connect to an Expert</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="brand-types" aria-labelledby="merinoCategoriesTitle">
    <div class="container-lg">
      <div class="brand-types__intro">
        <h2 id="merinoCategoriesTitle">Merino Categories</h2>
        <span class="brand-about__divider" aria-hidden="true"></span>
      </div>
      <div class="brand-types__grid" aria-label="Merino product categories">
        <article class="brand-type-card fade-up" data-delay="0">
          <img src="/assets/images/category/designer-laminates_1.jpg" alt="Merino laminate kitchen surface" />
          <div class="brand-type-card__content">
            <h3>Laminates</h3>
            <p>Premium laminates with trendsetting designs for expressive, durable interiors.</p>
            <a class="featured-interiors__button" href="/brand/merino/laminate">Know More <span aria-hidden="true">+</span></a>
          </div>
        </article>

        <article class="brand-type-card fade-up" data-delay="180">
          <img src="/assets/images/brands/merino/merino-panels.webp" alt="Merino panel board" />
          <div class="brand-type-card__content">
            <h3>Panels</h3>
            <p>PU and acrylic-coated panels on chipboard, plywood, and MDF in matte or gloss finishes.</p>
            <a class="featured-interiors__button" href="/brand/merino/panel">Know More <span aria-hidden="true">+</span></a>
          </div>
        </article>

        <article class="brand-type-card fade-up" data-delay="360">
          <img src="/assets/images/brands/merino/merino-solide.jpg" alt="Merino solid surface application" />
