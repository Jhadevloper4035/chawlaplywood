<section class="board-help-cta" aria-labelledby="boardHelpTitle">
  <div class="board-help-cta__background" aria-hidden="true"></div>
  <div class="container-lg">
    <div class="board-help-cta__layout">
      <div class="board-help-cta__intro fade-up">
        <p>(Product Guidance)</p>
        <h2 id="boardHelpTitle" class=" fw-3">Need help choosing the right board?</h2>
        <p>Share your requirement and our team will help you find the best fit for your furniture or interior project.</p>
      </div>
      <div class="board-help-cta__form-wrap fade-up">
        <form class="board-help-cta__form" action="mailto:info@motherwood.in?subject=Board%20selection%20enquiry" method="post" enctype="text/plain">
          <p class="board-help-cta__form-intro">Tell us what you are working on and we will get back to you.</p>
          <div class="board-help-cta__fields">
            <div>
              <label class="visually-hidden" for="boardHelpName">Name</label>
              <input id="boardHelpName" name="name" type="text" placeholder="Name *" autocomplete="name" required />
            </div>
            <div>
              <label class="visually-hidden" for="boardHelpEmail">Email address</label>
              <input id="boardHelpEmail" name="email" type="email" placeholder="Email address *" autocomplete="email" required />
            </div>
            <div>
              <label class="visually-hidden" for="boardHelpPhone">Mobile number</label>
              <input id="boardHelpPhone" name="phone" type="tel" placeholder="Mobile number *" autocomplete="tel" required />
            </div>
            <div>
              <label class="visually-hidden" for="boardHelpCity">City</label>
              <input id="boardHelpCity" name="city" type="text" placeholder="City *" autocomplete="address-level2" required />
            </div>
            <div>
              <label class="visually-hidden" for="boardHelpRole">You are a</label>
              <select id="boardHelpRole" name="role" required>
                <option value="" selected disabled>You are a *</option>
                <option>Homeowner</option>
                <option>Architect or interior designer</option>
                <option>Contractor or carpenter</option>
                <option>Dealer</option>
              </select>
            </div>
            <div>
              <label class="visually-hidden" for="boardHelpProduct">Product requirement</label>
              <input id="boardHelpProduct" name="requirement" type="text" placeholder="Product requirement" />
            </div>
            <div class="board-help-cta__message">
              <label class="visually-hidden" for="boardHelpMessage">Project details</label>
              <textarea id="boardHelpMessage" name="message" placeholder="Tell us about your project"></textarea>
            </div>
          </div>
          <label class="board-help-cta__consent">
            <input name="consent" type="checkbox" required />
            <span>I agree to be contacted about this enquiry.</span>
          </label>
          <button class="board-help-cta__submit" type="submit">Request a callback</button>
        </form>
      </div>
    </div>
  </div>
</section>
