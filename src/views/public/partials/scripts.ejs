  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const filterGroup = document.querySelector("[data-finish-filters]");
      const cards = document.querySelectorAll("[data-finish-card]");

      if (!filterGroup || !cards.length) return;

      filterGroup.addEventListener("click", function (event) {
        const button = event.target.closest("button[data-filter]");
        if (!button) return;

        const selectedFilter = button.dataset.filter;

        filterGroup.querySelectorAll("button").forEach(function (item) {
          const isActive = item === button;
          item.classList.toggle("active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });

        cards.forEach(function (card) {
          const isVisible =
            selectedFilter === "all" ||
            card.dataset.category === selectedFilter;
          card.classList.toggle("is-hidden", !isVisible);
        });
      });
    });
  </script>
