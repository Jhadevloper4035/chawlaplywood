  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const filterGroup = document.querySelector("[data-finish-filters]");
      const cards = document.querySelectorAll("[data-finish-card]");

      if (!filterGroup || !cards.length) return;

      filterGroup.addEventListener("click", function (event) {
        const button = event.target.closest("button[data-filter]");
        if (!button) return;

        const selectedFilter = button.dataset.filter;

        filterGroup.querySelectorAll("button").forEach(function (item) {
          const isActive = item === button;
          item.classList.toggle("active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });

        cards.forEach(function (card) {
          const isVisible =
            selectedFilter === "all" ||
            card.dataset.category === selectedFilter;
          card.classList.toggle("is-hidden", !isVisible);
        });
      });
    });
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const appliedFilters = document.querySelector("[data-applied-filters]");
      const appliedList = document.querySelector("[data-applied-filter-list]");
      const filterInputs = document.querySelectorAll(".all-products__filter-checkbox");

      if (!appliedFilters || !appliedList || !filterInputs.length) return;

      const renderAppliedFilters = function () {
        appliedList.innerHTML = "";

        filterInputs.forEach(function (input) {
          if (!input.checked) return;

          const chip = document.createElement("span");
          chip.className = "all-products__filter-chip";
          chip.textContent = input.value;

          const removeButton = document.createElement("button");
          removeButton.type = "button";
          removeButton.textContent = "x";
          removeButton.setAttribute("aria-label", "Remove " + input.value);
          removeButton.addEventListener("click", function () {
            input.checked = false;
            renderAppliedFilters();
          });

          chip.appendChild(removeButton);
          appliedList.appendChild(chip);
        });

        appliedFilters.classList.toggle("is-empty", !appliedList.children.length);
      };

      filterInputs.forEach(function (input) {
        input.addEventListener("change", renderAppliedFilters);
      });
    });
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const shareInput = document.querySelector("[data-share-url]");
      const copyButton = document.querySelector("[data-copy-share-url]");
      if (!shareInput || !copyButton) return;

      const shareUrl = window.location.href;
      const shareTitle = document.title;
      const originalText = copyButton.textContent;
      shareInput.value = shareUrl;

      const encodedUrl = encodeURIComponent(shareUrl);
      const encodedTitle = encodeURIComponent(shareTitle);
      const whatsapp = document.querySelector("[data-share-whatsapp]");
      const facebook = document.querySelector("[data-share-facebook]");
      const x = document.querySelector("[data-share-x]");
      const email = document.querySelector("[data-share-email]");

      if (whatsapp) whatsapp.href = "https://wa.me/?text=" + encodedTitle + "%20" + encodedUrl;
      if (facebook) facebook.href = "https://www.facebook.com/sharer/sharer.php?u=" + encodedUrl;
      if (x) x.href = "https://twitter.com/intent/tweet?url=" + encodedUrl + "&text=" + encodedTitle;
      if (email) email.href = "mailto:?subject=" + encodedTitle + "&body=" + encodedUrl;

      const copyUrl = async function (url) {
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(url);
            return true;
          } catch (error) {}
        }

        shareInput.focus();
        shareInput.select();
        shareInput.setSelectionRange(0, shareInput.value.length);
        return document.execCommand("copy");
      };

      copyButton.addEventListener("click", async function () {
        const copied = await copyUrl(shareInput.value);
        copyButton.textContent = copied ? "Copied" : "Select & Copy";
        setTimeout(function () {
          copyButton.textContent = originalText;
        }, 1600);
      });
    });
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const gallery = document.querySelector("[data-product-gallery]");
      if (!gallery) return;

      const preview = gallery.querySelector("[data-product-preview]");
      const zoomArea = gallery.querySelector("[data-product-zoom]");
      const magnifier = gallery.querySelector(".product-detail__magnifier");
      const thumbs = gallery.querySelectorAll("[data-product-thumb]");

      const setMagnifierImage = function () {
        if (!magnifier || !preview) return;
        magnifier.style.backgroundImage = 'url("' + preview.src + '")';
      };

      setMagnifierImage();

      if (zoomArea && magnifier && preview) {
        zoomArea.addEventListener("pointermove", function (event) {
          const rect = zoomArea.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width) * 100;
          const y = ((event.clientY - rect.top) / rect.height) * 100;

          magnifier.style.left = event.clientX - rect.left + "px";
          magnifier.style.top = event.clientY - rect.top + "px";
          magnifier.style.backgroundPosition = x + "% " + y + "%";
          zoomArea.classList.add("is-zooming");
        });

        zoomArea.addEventListener("pointerleave", function () {
          zoomArea.classList.remove("is-zooming");
        });
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener("click", function () {
          preview.src = thumb.dataset.productThumb;
          setMagnifierImage();
          thumbs.forEach(function (item) {
            item.classList.toggle("active", item === thumb);
          });
        });
      });
    });
  </script>
